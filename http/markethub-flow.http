### 20. Buyer direct purchase
POST {{host}}/api/v1/orders/purchase
Authorization: Bearer {{buyerToken}}
Content-Type: application/json
Accept: application/json

{
  "items": [
    {
      "productId": "{{productId}}",
      "quantity": 2
    }
  ]
}

> {%
client.test("Direct purchase created", function () {
  client.assert(response.status === 201, "Expected 201");
  client.assert(response.body.id, "Missing order id");
});
client.global.set("directOrderId", response.body.id);
%}

