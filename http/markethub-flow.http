### 15. Upload product image
POST {{host}}/api/v1/products/{{productId}}/images?position=1
Authorization: Bearer {{merchantToken}}
Content-Type: multipart/form-data; boundary=MarketHubBoundary
Accept: application/json

--MarketHubBoundary
Content-Disposition: form-data; name="image"; filename="sample-product.png"
Content-Type: image/png

< ./sample-product.png
--MarketHubBoundary--

> {%
client.test("Product image uploaded", function () {
  client.assert(response.status === 201, "Expected 201");
  client.assert(response.body.id, "Missing image id");
});
client.global.set("imageId", response.body.id);
%}

