# MarketHub full working-flow requests
# Run these from top to bottom with the JetBrains/IntelliJ HTTP Client.
# If your .env overrides APP_ADMIN_EMAIL or APP_ADMIN_PASSWORD, update these variables.
# The Docker profile defaults REQUEST_LIMIT to 10/min; raise it while running the full flow,
# or wait for the rate-limit window between batches.
#
# Google OAuth2 is a browser redirect flow, so it cannot be completed by this
# HTTP Client file like the JSON login/register requests below.
# To try it locally, open this URL in your browser:
#   http://localhost:8080/oauth2/authorization/google


@host = http://localhost:8080
@adminEmail = admin@markethub.local
@adminPassword = admin12345
@merchantPassword = merchantPass123
@buyerPassword = buyerPass123

### 00. Public smoke check
GET {{host}}/api/v1/products?page=0&size=1
Accept: application/json

> {%
client.test("Public API is reachable", function () {
  client.assert(response.status === 200, "Expected 200");
});
%}

### 01. Admin login
POST {{host}}/api/v1/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

> {%
client.test("Admin login succeeded", function () {
  client.assert(response.status === 200, "Expected 200");
  client.assert(response.body.token, "Missing admin token");
});
client.global.set("adminToken", response.body.token);
%}

### 02. Create category as admin
POST {{host}}/api/v1/admin/categories
Authorization: Bearer {{adminToken}}
Content-Type: application/json
Accept: application/json

{
  "name": "HTTP Flow Electronics {{$timestamp}}",
  "description": "Category created by http/markethub-flow.http"
}

> {%
client.test("Category created", function () {
  client.assert(response.status === 201, "Expected 201");
  client.assert(response.body.id, "Missing category id");
});
client.global.set("categoryId", response.body.id);
%}

### 03. Update category as admin
PUT {{host}}/api/v1/admin/categories/{{categoryId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json
Accept: application/json

{
  "name": "HTTP Flow Consumer Electronics {{$timestamp}}",
  "description": "Updated category created by http/markethub-flow.http"
}

> {%
client.test("Category updated", function () {
  client.assert(response.status === 200, "Expected 200");
});
%}

### 04. Public active categories
GET {{host}}/api/v1/categories?page=0&size=10&sort=createdAt,desc
Accept: application/json

> {%
client.test("Public categories are reachable", function () {
  client.assert(response.status === 200, "Expected 200");
});
%}

### 05. Public category by id
GET {{host}}/api/v1/categories/{{categoryId}}
Accept: application/json

> {%
client.test("Public category is reachable", function () {
  client.assert(response.status === 200, "Expected 200");
});
%}

### 06. Register merchant user
POST {{host}}/api/v1/auth/register
Content-Type: application/json
Accept: application/json

{
  "firstName": "Mira",
  "lastName": "Merchant",
  "birthDate": "1994-04-14",
  "email": "merchant-{{$timestamp}}@markethub.test",
  "password": "{{merchantPassword}}"
}

> {%
client.test("Merchant user registered", function () {
  client.assert(response.status === 200, "Expected 200");
  client.assert(response.body.token, "Missing merchant token");
});
client.global.set("merchantToken", response.body.token);
%}

### 07. Create merchant profile
POST {{host}}/api/v1/merchants/me
Authorization: Bearer {{merchantToken}}
Content-Type: application/json
Accept: application/json

{
  "shopName": "HTTP Flow Shop {{$timestamp}}",
  "description": "Merchant profile created by http/markethub-flow.http"
}

> {%
client.test("Merchant profile created", function () {
  client.assert(response.status === 201, "Expected 201");
  client.assert(response.body.id, "Missing merchant id");
});
client.global.set("merchantId", response.body.id);
%}

### 08. Admin list unverified merchants
GET {{host}}/api/v1/admin/merchants/unverified?page=0&size=10&sort=createdAt,desc
Authorization: Bearer {{adminToken}}
Accept: application/json

> {%
client.test("Unverified merchants are reachable", function () {
  client.assert(response.status === 200, "Expected 200");
});
%}

### 09. Admin verify merchant
PATCH {{host}}/api/v1/admin/merchants/{{merchantId}}/verify
Authorization: Bearer {{adminToken}}
Accept: application/json

> {%
client.test("Merchant verified", function () {
  client.assert(response.status === 200, "Expected 200");
  client.assert(response.body.verified === true, "Merchant should be verified");
});
%}

