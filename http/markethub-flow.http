### 12. Merchant creates product
POST {{host}}/api/v1/merchant/products
Authorization: Bearer {{merchantToken}}
Content-Type: application/json
Accept: application/json

{
  "name": "HTTP Flow Mechanical Keyboard",
  "description": "A product created by http/markethub-flow.http",
  "priceCents": 7999,
  "stockQuantity": 10,
  "categoryId": "{{categoryId}}"
}

> {%
client.test("Product created", function () {
  client.assert(response.status === 201, "Expected 201");
  client.assert(response.body.id, "Missing product id");
});
client.global.set("productId", response.body.id);
%}

